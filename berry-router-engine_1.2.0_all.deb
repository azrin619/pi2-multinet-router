#!/usr/bin/env bash
# ===================================================================
# Berry Router Engine - Debian Package Builder (.deb)
# ===================================================================

set -e

PKG_NAME="berry-router-engine"
VERSION="1.2.0"
BUILD_DIR="pkg_build"
DEB_FILE="${PKG_NAME}_${VERSION}_all.deb"

echo "🧹 Cleaning previous build artifacts..."
rm -rf "$BUILD_DIR" "$DEB_FILE"

echo "📁 Creating Debian package directory tree..."
mkdir -p "${BUILD_DIR}/DEBIAN"
mkdir -p "${BUILD_DIR}/usr/local/bin"
mkdir -p "${BUILD_DIR}/etc/berry-router"
mkdir -p "${BUILD_DIR}/etc/systemd/system"
mkdir -p "${BUILD_DIR}/var/cache/berry-router/drivers"

# Copy source scripts
cp src/berry_bootstrap_ip88.py "${BUILD_DIR}/usr/local/bin/berry_bootstrap_ip88.py"
cp src/berry_wifi_autobind.sh "${BUILD_DIR}/usr/local/bin/berry_wifi_autobind.sh"
cp src/berry_driver_loader.py "${BUILD_DIR}/usr/local/bin/berry_driver_loader.py"
cp src/router_engine.py "${BUILD_DIR}/usr/local/bin/router_engine.py"

chmod +x ${BUILD_DIR}/usr/local/bin/*

# Default WiFi config
if [ -f "etc/berry-router/wifi.conf" ]; then
    cp etc/berry-router/wifi.conf "${BUILD_DIR}/etc/berry-router/wifi.conf"
else
    cat << 'EOF' > "${BUILD_DIR}/etc/berry-router/wifi.conf"
WIFI_SSID="MyRouterNetwork"
WIFI_PASS="RouterSecret123"
EOF
fi
chmod 600 "${BUILD_DIR}/etc/berry-router/wifi.conf"

# Generate DEBIAN/control with hardened dependencies
cat << EOF > "${BUILD_DIR}/DEBIAN/control"
Package: ${PKG_NAME}
Version: ${VERSION}
Section: net
Priority: optional
Architecture: all
Depends: python3, python3-pip, iproute2, wpasupplicant, wireless-tools, openssh-server, cockpit, iputils-arping, pciutils
Maintainer: Berry Router Team <admin@berryrouter.local>
Description: High-availability routing, hotplug driver auto-installer, and static IP management engine.
EOF

# Systemd Service Units
cat << 'EOF' > "${BUILD_DIR}/etc/systemd/system/berry-eth0-bootstrap.service"
[Unit]
Description=Berry Router Dynamic Subnet .88 Assigner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/berry_bootstrap_ip88.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

cat << 'EOF' > "${BUILD_DIR}/etc/systemd/system/berry-wifi-auto.service"
[Unit]
Description=Berry Router Dynamic Wi-Fi Auto-Binder
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/berry_wifi_autobind.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

cat << 'EOF' > "${BUILD_DIR}/etc/systemd/system/berry-driver-loader.service"
[Unit]
Description=Berry Router USB Hotplug Driver Auto-Installer
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/berry_driver_loader.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
EOF

cat << 'EOF' > "${BUILD_DIR}/etc/systemd/system/router-engine.service"
[Unit]
Description=Berry Router Core Multi-Cloud ECMP & Route Engine
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/router_engine.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

# Post-install script to enable services
cat << 'EOF' > "${BUILD_DIR}/DEBIAN/postinst"
#!/bin/sh
set -e
systemctl daemon-reload
systemctl enable berry-eth0-bootstrap.service
systemctl enable berry-wifi-auto.service
systemctl enable berry-driver-loader.service
systemctl enable router-engine.service
EOF
chmod +x "${BUILD_DIR}/DEBIAN/postinst"

echo "📦 Building package: ${DEB_FILE}..."
dpkg-deb --build "$BUILD_DIR" "$DEB_FILE"
echo "✅ Package built successfully!"
